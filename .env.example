# Environment reference for running bot.py directly.
# bot.py does not automatically read .env files.
# The Linux service reads /etc/telegram-quiz-bot/bot.env.
BOT_TOKEN_FILE=data/token.txt
# Automatic Telegraph publishing uses a separate account token in
# data/telegraph-token.txt by default (next to BOT_TOKEN_FILE).
# Keep both secrets out of chat, command arguments, logs and release archives.
# Direct bot.py execution also supports an optional TELEGRAPH_TOKEN_FILE override.
# The Linux installer accepts only the three settings shown in its own example.

# Numeric Telegram user ID, not a username or telephone number.
OWNER_USER_ID=REPLACE_WITH_YOUR_NUMERIC_ID
STATE_DIR=data
