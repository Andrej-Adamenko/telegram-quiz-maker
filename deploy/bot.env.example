# Copy to /etc/telegram-quiz-bot/bot.env, owned by root with mode 0600.
# The installer accepts only these three unquoted settings.
# Automatic publishing reads the separate Telegraph account token from
# /etc/telegram-quiz-bot/telegraph-token.txt (root:quizbot, mode 0640).
# Keep it on the server; do not add its value or another setting to this file.
BOT_TOKEN_FILE=/etc/telegram-quiz-bot/token.txt
OWNER_USER_ID=REPLACE_WITH_YOUR_NUMERIC_ID
STATE_DIR=/var/lib/telegram-quiz-bot
